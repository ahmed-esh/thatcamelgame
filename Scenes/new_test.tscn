[sub_resource type="Shader" id="Shader_lpr41"]
code = "shader_type spatial;
render_mode diffuse_lambert, cull_back;
uniform vec3 deep_color : source_color = vec3(0.025, 0.09, 0.18);
uniform vec3 ripple_color : source_color = vec3(0.12, 0.48, 0.62);
uniform float wave_height : hint_range(0.0, 0.3) = 0.06;
uniform float wave_speed : hint_range(0.0, 2.0) = 0.45;
uniform vec4 ripples[12];
uniform float ripple_clock = 0.0;
varying vec2 water_position;
float disturbance(vec2 p) {
    float result = 0.0;
    for (int i = 0; i < 12; i++) {
        float age = ripple_clock - ripples[i].z;
        if (age > 0.0 && age < 4.5 && ripples[i].w > 0.0) {
            float distance_from_source = distance(p, ripples[i].xy);
            float ring = distance_from_source - age * 3.0;
            float envelope = (1.0 - smoothstep(0.3, 1.3, abs(ring))) * (1.0 - age / 4.5);
            result += sin(ring * 5.0) * envelope * ripples[i].w;
        }
    }
    return result;
}
void vertex() {
    water_position = VERTEX.xz;
    VERTEX.y += sin(VERTEX.x * 0.32 + TIME * wave_speed) * cos(VERTEX.z * 0.27 + TIME * wave_speed * 0.8) * wave_height;
    VERTEX.y += disturbance(VERTEX.xz) * 0.16;
}
void fragment() {
    vec2 p = floor(water_position * 5.0) / 5.0;
    float first = sin(p.x * 1.8 + p.y * 0.9 + TIME * wave_speed);
    float second = sin(p.y * 2.1 - p.x * 0.6 - TIME * wave_speed * 0.7);
    float ripple = smoothstep(0.92, 0.99, sin(p.x * 0.85 + p.y * 1.1 + first * 1.4 + TIME * wave_speed)) * (0.55 + second * 0.45);
    float wake = disturbance(water_position);
    float foam = smoothstep(0.08, 0.45, abs(wake));
    float fresnel = pow(1.0 - clamp(dot(normalize(NORMAL), VIEW), 0.0, 1.0), 3.0);
    ALBEDO = mix(deep_color, ripple_color, clamp(ripple * 0.18 + fresnel * 0.24 + foam * 0.65, 0.0, 1.0));
    EMISSION = ripple_color * (ripple * 0.025 + foam * 0.2);
    ROUGHNESS = 0.32;
    SPECULAR = 0.6;
}
"


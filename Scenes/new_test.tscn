[sub_resource type="GDScript" id="GDScript_to74b"]
script/source = "extends MeshInstance3D

const SIDE := 257
const BASE_SPACING := 8.0
const SPACING := 0.5
const EXTENT := 1024.0
const PATCH_CELLS := 128
var base_arrays: Array
var base_vertices: PackedVector3Array
var changed_heights: Dictionary = {}
var changed_patches: Dictionary = {}
var patches: Dictionary = {}
var coarse_shapes: Dictionary = {}
var coarse_indices: Dictionary = {}
var patch_arrays: Dictionary = {}
var detail_indices := PackedInt32Array()
var patch_heights: Dictionary = {}
var changed_cells: Dictionary = {}
var original_heights: Dictionary = {}
var active_sand: Dictionary = {}
var glow_cells: Dictionary = {}
var disturbance_image: Image
var disturbance_texture: ImageTexture
var flush_clock := 0.0
var transported_volume := 0.0
var flow_enabled := true
const FLOW_LIMIT := 384
const FLOW_STEP := 0.1
const NEIGHBORS := [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1), Vector2i(1, 1), Vector2i(-1, 1), Vector2i(1, -1), Vector2i(-1, -1)]

func _ready() -> void:
    if Engine.is_editor_hint():
        return
    base_arrays = mesh.surface_get_arrays(0)
    base_vertices = base_arrays[Mesh.ARRAY_VERTEX]
    detail_indices.resize(PATCH_CELLS * PATCH_CELLS * 6)
    for z in PATCH_CELLS:
        for x in PATCH_CELLS:
            var vertex := z * (PATCH_CELLS + 1) + x
            var index := (z * PATCH_CELLS + x) * 6
            detail_indices[index] = vertex
            detail_indices[index + 1] = vertex + 1
            detail_indices[index + 2] = vertex + PATCH_CELLS + 1
            detail_indices[index + 3] = vertex + 1
            detail_indices[index + 4] = vertex + PATCH_CELLS + 2
            detail_indices[index + 5] = vertex + PATCH_CELLS + 1
    material_override = material_override.duplicate()
    disturbance_image = Image.create_empty(1024, 1024, false, Image.FORMAT_R8)
    disturbance_texture = ImageTexture.create_from_image(disturbance_image)
    material_override.set_shader_parameter(\"disturbance_map\", disturbance_texture)
    for pz in range(-16, 16):
        for px in range(-16, 16):
            var patch := Vector2i(px, pz)
            var patch_indices := PackedInt32Array()
            for z in 9:
                for x in 9:
                    var index := ((pz + 16) * 8 + z) * SIDE + (px + 16) * 8 + x
                    if x < 8 and z < 8:
                        patch_indices.append_array(PackedInt32Array([index, index + 1, index + SIDE, index + 1, index + SIDE + 1, index + SIDE]))
            coarse_shapes[patch] = get_node(\"Ground/Tile_%d_%d\" % [px + 16, pz + 16])
            coarse_indices[patch] = patch_indices

func base_height(point: Vector3) -> float:
    var grid := (Vector2(point.x, point.z) + Vector2.ONE * EXTENT) / BASE_SPACING
    var x := clampi(floori(grid.x), 0, SIDE - 2)
    var z := clampi(floori(grid.y), 0, SIDE - 2)
    var weight := (grid - Vector2(x, z)).clamp(Vector2.ZERO, Vector2.ONE)
    var index := z * SIDE + x
    var a := base_vertices[index].y
    var b := base_vertices[index + 1].y
    var c := base_vertices[index + SIDE].y
    var d := base_vertices[index + SIDE + 1].y
    if weight.x + weight.y <= 1.0:
        return a + (b - a) * weight.x + (c - a) * weight.y
    return d + (c - d) * (1.0 - weight.x) + (b - d) * (1.0 - weight.y)

func height_at(point: Vector3) -> float:
    var local_point := to_local(point)
    var grid := Vector2(local_point.x, local_point.z) / SPACING
    var key := Vector2i(floori(grid.x), floori(grid.y))
    var weight := grid - Vector2(key)
    var a := cell_height(key)
    var b := cell_height(key + Vector2i(1, 0))
    var c := cell_height(key + Vector2i(0, 1))
    var d := cell_height(key + Vector2i(1, 1))
    var height := a + (b - a) * weight.x + (c - a) * weight.y
    if weight.x + weight.y > 1.0:
        height = d + (c - d) * (1.0 - weight.x) + (b - d) * (1.0 - weight.y)
    return to_global(Vector3(local_point.x, height, local_point.z)).y

func cell_position(key: Vector2i) -> Vector3:
    return Vector3(key.x * SPACING, 0.0, key.y * SPACING)

func cell_height(key: Vector2i) -> float:
    if changed_heights.has(key):
        return changed_heights[key]
    return base_height(cell_position(key))

func remember_cell(key: Vector2i) -> float:
    if not original_heights.has(key):
        original_heights[key] = cell_height(key)
    return original_heights[key]

func set_cell_height(key: Vector2i, height: float) -> void:
    if absf(cell_height(key) - height) < 0.001:
        return
    changed_heights[key] = height
    changed_cells[key] = true
    for direction: Vector2i in NEIGHBORS:
        changed_cells[key + direction] = true
    for z in range(-2, 2):
        for x in range(-2, 2):
            var patch := Vector2i(floori(float(key.x + x) / PATCH_CELLS), floori(float(key.y + z) / PATCH_CELLS))
            if patch.x >= -16 and patch.x < 16 and patch.y >= -16 and patch.y < 16:
                changed_patches[patch] = true

func flush_deformation() -> void:
    if changed_patches.is_empty():
        return
    var rebuild_base := false
    for patch: Vector2i in changed_patches:
        if not patches.has(patch):
            var surface := MeshInstance3D.new()
            surface.position = Vector3(patch.x * 64.0, 0.0, patch.y * 64.0)
            surface.material_override = material_override
            surface.cast_shadow = cast_shadow
            var body := StaticBody3D.new()
            var collider := CollisionShape3D.new()
            collider.name = \"CollisionShape3D\"
            collider.position = Vector3(32.0, 0.0, 32.0)
            collider.scale = Vector3(SPACING, 1.0, SPACING)
            var shape := HeightMapShape3D.new()
            shape.map_width = PATCH_CELLS + 1
            shape.map_depth = PATCH_CELLS + 1
            collider.shape = shape
            body.name = \"Ground\"
            body.add_child(collider)
            surface.add_child(body)
            add_child(surface)
            patches[patch] = surface
            coarse_shapes[patch].disabled = true
            rebuild_base = true
        update_patch(patch)
    if rebuild_base:
        var indices := PackedInt32Array()
        for patch: Vector2i in coarse_indices:
            if not patches.has(patch):
                indices.append_array(coarse_indices[patch])
        base_arrays[Mesh.ARRAY_INDEX] = indices
        var dunes := ArrayMesh.new()
        dunes.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, base_arrays)
        mesh = dunes
    changed_patches.clear()
    changed_cells.clear()

func height_offset(key: Vector2i) -> float:
    if not changed_heights.has(key):
        return 0.0
    return changed_heights[key] - base_height(cell_position(key))

func surface_normal(key: Vector2i) -> Vector3:
    var grid := (Vector2(key) * SPACING + Vector2.ONE * EXTENT) / BASE_SPACING
    var x := clampi(floori(grid.x), 0, SIDE - 2)
    var z := clampi(floori(grid.y), 0, SIDE - 2)
    var weight := (grid - Vector2(x, z)).clamp(Vector2.ZERO, Vector2.ONE)
    var index := z * SIDE + x
    var normals: PackedVector3Array = base_arrays[Mesh.ARRAY_NORMAL]
    var normal := normals[index] + (normals[index + 1] - normals[index]) * weight.x + (normals[index + SIDE] - normals[index]) * weight.y
    if weight.x + weight.y > 1.0:
        normal = normals[index + SIDE + 1] + (normals[index + SIDE] - normals[index + SIDE + 1]) * (1.0 - weight.x) + (normals[index + 1] - normals[index + SIDE + 1]) * (1.0 - weight.y)
    var dx := (height_offset(key + Vector2i(-1, 0)) - height_offset(key + Vector2i(1, 0))) / (SPACING * 2.0)
    var dz := (height_offset(key + Vector2i(0, -1)) - height_offset(key + Vector2i(0, 1))) / (SPACING * 2.0)
    return Vector3(normal.x / normal.y + dx, 1.0, normal.z / normal.y + dz).normalized()

func update_patch(patch: Vector2i) -> void:
    var width := PATCH_CELLS + 1
    var arrays: Array
    var heights: PackedFloat32Array
    var cells: Array = changed_cells.keys()
    if patch_arrays.has(patch):
        arrays = patch_arrays[patch]
        heights = patch_heights[patch]
    else:
        arrays = []
        arrays.resize(Mesh.ARRAY_MAX)
        var vertices := PackedVector3Array()
        var normals := PackedVector3Array()
        var colors := PackedColorArray()
        colors.resize(width * width)
        colors.fill(Color.WHITE)
        vertices.resize(width * width)
        normals.resize(width * width)
        heights.resize(width * width)
        var base_normals: PackedVector3Array = base_arrays[Mesh.ARRAY_NORMAL]
        for z in width:
            var grid_z := (patch.y + 16) * 8.0 + z * SPACING / BASE_SPACING
            var bz := mini(floori(grid_z), SIDE - 2)
            var wz := grid_z - bz
            for x in width:
                var index := z * width + x
                var grid_x := (patch.x + 16) * 8.0 + x * SPACING / BASE_SPACING
                var bx := mini(floori(grid_x), SIDE - 2)
                var wx := grid_x - bx
                var bi := bz * SIDE + bx
                var h: float
                var n: Vector3
                if wx + wz <= 1.0:
                    h = base_vertices[bi].y * (1.0 - wx - wz) + base_vertices[bi + 1].y * wx + base_vertices[bi + SIDE].y * wz
                    n = base_normals[bi] * (1.0 - wx - wz) + base_normals[bi + 1] * wx + base_normals[bi + SIDE] * wz
                else:
                    h = base_vertices[bi + SIDE + 1].y * (wx + wz - 1.0) + base_vertices[bi + SIDE].y * (1.0 - wx) + base_vertices[bi + 1].y * (1.0 - wz)
                    n = base_normals[bi + SIDE + 1] * (wx + wz - 1.0) + base_normals[bi + SIDE] * (1.0 - wx) + base_normals[bi + 1] * (1.0 - wz)
                vertices[index] = Vector3(x * SPACING, h, z * SPACING)
                normals[index] = n.normalized()
                heights[index] = h
        arrays[Mesh.ARRAY_VERTEX] = vertices
        arrays[Mesh.ARRAY_NORMAL] = normals
        arrays[Mesh.ARRAY_COLOR] = colors
        arrays[Mesh.ARRAY_INDEX] = detail_indices
    var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
    var normals: PackedVector3Array = arrays[Mesh.ARRAY_NORMAL]
    var colors: PackedColorArray = arrays[Mesh.ARRAY_COLOR]
    for key: Vector2i in cells:
        var local_key := key - patch * PATCH_CELLS
        if local_key.x < 0 or local_key.x >= width or local_key.y < 0 or local_key.y >= width:
            continue
        var index := local_key.y * width + local_key.x
        vertices[index].y = cell_height(key)
        normals[index] = surface_normal(key)
        heights[index] = vertices[index].y
        var offset := height_offset(key)
        colors[index] = Color(1.0 - clampf(-offset / 0.12, 0.0, 1.0), 1.0 - clampf(offset / 0.07, 0.0, 1.0), 1.0, 1.0)
    arrays[Mesh.ARRAY_COLOR] = colors
    arrays[Mesh.ARRAY_VERTEX] = vertices
    arrays[Mesh.ARRAY_NORMAL] = normals
    patch_arrays[patch] = arrays
    patch_heights[patch] = heights
    var dunes := ArrayMesh.new()
    dunes.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
    var surface: MeshInstance3D = patches[patch]
    surface.mesh = dunes
    var shape: HeightMapShape3D = surface.get_node(\"Ground/CollisionShape3D\").shape
    shape.map_data = heights

func stamp(point: Vector3, radius: Vector2, depth: float, angle: float = 0.0) -> void:
    if absf(point.x) > EXTENT - 2.0 or absf(point.z) > EXTENT - 2.0:
        return
    wake_sand(point, maxf(radius.x, radius.y) + 0.6, 1.0)
    illuminate(point, maxf(radius.x, radius.y) + 0.35, 0.8)
    var reach := maxf(radius.x, radius.y) * 1.65
    var center := Vector2i(roundi(point.x / SPACING), roundi(point.z / SPACING))
    var cells := ceili(reach / SPACING)
    for z in range(-cells, cells + 1):
        for x in range(-cells, cells + 1):
            var key := center + Vector2i(x, z)
            var sample_point := Vector3(key.x * SPACING, 0.0, key.y * SPACING)
            var offset := Vector2(sample_point.x - point.x, sample_point.z - point.z).rotated(-angle)
            var distance := (offset / radius).length()
            distance *= 1.0 + 0.045 * sin(offset.x * 17.0 + offset.y * 11.0)
            if distance > 1.65:
                continue
            var current := cell_height(key)
            if not is_finite(current):
                continue
            if not original_heights.has(key):
                original_heights[key] = current
            var baseline: float = original_heights[key]
            var depression := depth * (1.0 - smoothstep(0.45, 1.1, distance))
            var rim := depth * 0.32 * exp(-pow((distance - 1.18) * 3.8, 2.0))
            var target := baseline - depression + rim
            var updated := minf(current, target) if distance < 0.95 else maxf(current, target)
            if absf(updated - current) < 0.001:
                continue
            set_cell_height(key, updated)

func _physics_process(delta: float) -> void:
    flush_clock += delta
    if flush_clock >= FLOW_STEP:
        flush_clock = 0.0
        if flow_enabled:
            simulate_flow(FLOW_STEP)
        fade_disturbance(FLOW_STEP)
        flush_deformation()

func downhill_at(point: Vector3) -> Vector3:
    var distance := 1.2
    var dx := (height_at(point + Vector3.RIGHT * distance) - height_at(point + Vector3.LEFT * distance)) / (distance * 2.0)
    var dz := (height_at(point + Vector3.BACK * distance) - height_at(point + Vector3.FORWARD * distance)) / (distance * 2.0)
    return Vector3(-dx, 0.0, -dz)

func wake_sand(point: Vector3, radius: float, lifetime: float = 1.6) -> void:
    var center := Vector2i(roundi(point.x / SPACING), roundi(point.z / SPACING))
    var cells := ceili(radius / SPACING)
    for z in range(-cells, cells + 1):
        for x in range(-cells, cells + 1):
            if Vector2(x, z).length() * SPACING > radius:
                continue
            var key := center + Vector2i(x, z)
            if absi(key.x) * SPACING >= 1016 or absi(key.y) * SPACING >= 1016:
                continue
            if active_sand.size() < FLOW_LIMIT or active_sand.has(key):
                active_sand[key] = maxf(active_sand.get(key, 0.0), lifetime)

func simulate_flow(delta: float) -> void:
    var changes: Dictionary = {}
    var awaken: Dictionary = {}
    for key: Vector2i in active_sand.keys():
        var life: float = active_sand[key] - delta
        if life <= 0.0:
            active_sand.erase(key)
            continue
        active_sand[key] = life
        var source := cell_height(key)
        if not is_finite(source):
            active_sand.erase(key)
            continue
        var best := key
        var best_excess := 0.0
        for direction: Vector2i in NEIGHBORS:
            var neighbor := key + direction
            if absi(neighbor.x) * SPACING >= 1016 or absi(neighbor.y) * SPACING >= 1016:
                continue
            var target := cell_height(neighbor)
            var baseline_drop := base_height(cell_position(key)) - base_height(cell_position(neighbor))
            var excess := source - target - baseline_drop - 0.055 * SPACING * Vector2(direction).length()
            if is_finite(target) and excess > best_excess:
                best_excess = excess
                best = neighbor
        if best == key:
            continue
        var available := maxf(0.0, source - remember_cell(key) + 0.55)
        var room := maxf(0.0, remember_cell(best) + 0.65 - cell_height(best))
        var amount := minf(minf(best_excess * 0.035, 0.002), minf(available * 0.2, room * 0.125))
        if amount < 0.0005:
            continue
        changes[key] = changes.get(key, 0.0) - amount
        changes[best] = changes.get(best, 0.0) + amount
        awaken[best] = maxf(awaken.get(best, 0.0), life - 0.04)
        transported_volume += amount * SPACING * SPACING
        if amount > 0.004:
            illuminate(cell_position(best), 0.35, 0.45)
    for key: Vector2i in changes:
        set_cell_height(key, cell_height(key) + float(changes[key]))
    for key: Vector2i in awaken:
        if active_sand.size() < FLOW_LIMIT or active_sand.has(key):
            active_sand[key] = maxf(active_sand.get(key, 0.0), awaken[key])

func drag_sand(point: Vector3, direction: Vector3, strength: float) -> void:
    if direction.length_squared() < 0.01:
        return
    var center := Vector2i(roundi(point.x / SPACING), roundi(point.z / SPACING))
    var offset := Vector2i(roundi(direction.normalized().x * 3.0), roundi(direction.normalized().z * 3.0))
    var changes: Dictionary = {}
    for z in range(-3, 4):
        for x in range(-3, 4):
            var weight := maxf(0.0, 1.0 - Vector2(x, z).length() / 3.2)
            var key := center + Vector2i(x, z)
            var destination := key + offset
            if absi(destination.x) * SPACING >= 1016 or absi(destination.y) * SPACING >= 1016:
                continue
            var source := cell_height(key)
            var target := cell_height(destination)
            if not is_finite(source) or not is_finite(target):
                continue
            var available := maxf(0.0, source - remember_cell(key) + 0.48)
            var room := maxf(0.0, remember_cell(destination) + 0.55 - target)
            var amount := minf(0.045 * weight * clampf(strength, 0.0, 1.0), minf(available * 0.2, room * 0.2))
            changes[key] = changes.get(key, 0.0) - amount
            changes[destination] = changes.get(destination, 0.0) + amount
            transported_volume += amount * SPACING * SPACING
    for key: Vector2i in changes:
        set_cell_height(key, cell_height(key) + float(changes[key]))
    wake_sand(point + direction.normalized() * 0.6, 1.8, 2.0)
    illuminate(point, 1.1, 1.0)

func illuminate(point: Vector3, radius: float, intensity: float) -> void:
    var center := Vector2i(roundi((point.x + EXTENT) * 0.5), roundi((point.z + EXTENT) * 0.5))
    var cells := ceili(radius * 0.5)
    for z in range(-cells, cells + 1):
        for x in range(-cells, cells + 1):
            var pixel := center + Vector2i(x, z)
            if pixel.x < 0 or pixel.y < 0 or pixel.x >= 1024 or pixel.y >= 1024:
                continue
            var value := intensity * maxf(0.0, 1.0 - Vector2(x, z).length() / maxf(radius * 0.5, 1.0))
            if value > float(glow_cells.get(pixel, 0.0)):
                glow_cells[pixel] = value
                disturbance_image.set_pixelv(pixel, Color(value, 0.0, 0.0))

func fade_disturbance(delta: float) -> void:
    if glow_cells.is_empty():
        return
    for pixel: Vector2i in glow_cells.keys():
        var value := maxf(0.0, float(glow_cells[pixel]) - delta * 0.075)
        disturbance_image.set_pixelv(pixel, Color(value, 0.0, 0.0))
        if value <= 0.0:
            glow_cells.erase(pixel)
        else:
            glow_cells[pixel] = value
    disturbance_texture.update(disturbance_image)
"


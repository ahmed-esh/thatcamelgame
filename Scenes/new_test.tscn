[sub_resource type="Shader" id="Shader_khtd3"]
code = "shader_type spatial;
render_mode diffuse_lambert;

uniform sampler2D disturbance_map : filter_linear, repeat_disable, hint_default_black;
uniform vec3 flat_color : source_color = vec3(0.212, 0.349, 0.749);
uniform vec3 slope_color : source_color = vec3(0.094, 0.141, 0.357);
uniform vec3 highlight_color : source_color = vec3(0.576, 0.812, 1.0);
uniform vec3 magic_color : source_color = vec3(0.396, 0.945, 0.918);
varying vec3 world_position;
varying vec3 world_normal;
varying vec2 sand_imprint;
varying vec3 grain_normal;
varying float grain_visibility;
varying float disturbed_sheen;

float grain_hash(vec2 p) {
    return fract(sin(dot(p, vec2(83.17, 279.43))) * 17341.71);
}

float sand_noise(vec2 p) {
    vec2 cell = floor(p);
    vec2 t = fract(p);
    t = t * t * (3.0 - 2.0 * t);
    return mix(mix(grain_hash(cell), grain_hash(cell + vec2(1.0, 0.0)), t.x), mix(grain_hash(cell + vec2(0.0, 1.0)), grain_hash(cell + vec2(1.0)), t.x), t.y);
}

void vertex() {
    world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
    world_normal = normalize(MODEL_NORMAL_MATRIX * NORMAL);
    sand_imprint = vec2(1.0) - COLOR.rg;
}

void fragment() {
    vec2 p = world_position.xz;
    vec3 normal = normalize(world_normal);
    float distance_to_view = distance(CAMERA_POSITION_WORLD, world_position);
    float broad = sand_noise(p * 0.014);
    float warp = sand_noise(p * 0.047 + vec2(19.0, 7.0));
    float phase_a = dot(p, vec2(7.4, 2.1)) + world_position.y * 0.8 + broad * 12.0 + warp * 4.0;
    float phase_b = dot(p, vec2(2.3, -9.2)) + world_position.y * 0.6 + broad * 8.0 - warp * 5.0;
    float direction_mix = smoothstep(-0.22, 0.42, normal.x - normal.z + (broad - 0.5) * 0.5);
    float detail_fade = 1.0 - smoothstep(12.0, 65.0, distance_to_view);
    float fade_a = detail_fade * (1.0 - smoothstep(0.7, 2.4, fwidth(phase_a)));
    float fade_b = detail_fade * (1.0 - smoothstep(0.7, 2.4, fwidth(phase_b)));
    float ripple = mix(sin(phase_a) * fade_a, sin(phase_b) * fade_b, direction_mix);
    float imprint = smoothstep(0.02, 0.9, sand_imprint.x);
    float lip = smoothstep(0.02, 0.85, sand_imprint.y);
    float slope = 1.0 - clamp(normal.y, 0.0, 1.0);
    float shelter = smoothstep(0.015, 0.28, slope);
    ALBEDO = mix(flat_color, slope_color, shelter * 0.75);
    ALBEDO *= 0.88 + broad * 0.12 + smoothstep(6.0, 48.0, world_position.y) * 0.08 + ripple * 0.018;
    ALBEDO *= 1.0 - imprint * 0.18 + lip * 0.10;
    vec3 ripples = mix(vec3(0.064, 0.0, 0.018) * cos(phase_a) * fade_a, vec3(0.019, 0.0, -0.075) * cos(phase_b) * fade_b, direction_mix);
    normal = normalize(normal + (ripples - normal * dot(normal, ripples)) * (1.0 - imprint * 0.65));
    NORMAL = normalize(mat3(VIEW_MATRIX) * normal);
    float disturbance = texture(disturbance_map, (p + vec2(1024.0)) / 2048.0).r;
    float afterglow = disturbance * (imprint * 0.20 + lip * 0.38);
    EMISSION = magic_color * (afterglow + disturbance * 0.018);
    disturbed_sheen = 1.0 + lip * 0.5 + imprint * 0.15;
    grain_visibility = 0.0;
    grain_normal = NORMAL;
    vec2 grains = p * 22.0;
    float grain_pixel = max(fwidth(grains.x), fwidth(grains.y));
    float grain_filter = (1.0 - smoothstep(0.35, 1.2, grain_pixel)) * (1.0 - smoothstep(5.0, 24.0, distance_to_view));
    if (grain_filter > 0.001) {
        vec2 cell = floor(grains);
        float seed = grain_hash(cell);
        float second = grain_hash(cell + vec2(31.0, 17.0));
        vec2 center = vec2(seed, second) * 0.5 + 0.25;
        float radius = length(fract(grains) - center);
        float coverage = 1.0 - smoothstep(0.08, 0.16 + grain_pixel * 0.5, radius);
        grain_visibility = coverage * smoothstep(0.68, 0.94, seed) * grain_filter;
        vec3 tangent = normalize(vec3(normal.y, -normal.x, 0.0));
        vec3 bitangent = cross(normal, tangent);
        vec3 facet = normalize(normal + tangent * (seed - 0.5) * 1.1 + bitangent * (second - 0.5) * 1.1);
        grain_normal = normalize(mat3(VIEW_MATRIX) * facet);
    }
    ROUGHNESS = 0.88;
    SPECULAR = 0.0;
}

void light() {
    float facing_light = max(dot(NORMAL, LIGHT), 0.0);
    float diffuse = 0.06 + 0.94 * smoothstep(0.0, 0.95, facing_light);
    float grazing = pow(1.0 - max(dot(NORMAL, VIEW), 0.0), 3.0);
    vec3 halfway = normalize(LIGHT + VIEW);
    float silk = pow(max(dot(NORMAL, halfway), 0.0), 18.0);
    float glint = pow(max(dot(grain_normal, halfway), 0.0), 72.0) * grain_visibility;
    DIFFUSE_LIGHT += LIGHT_COLOR * diffuse * ATTENUATION / PI;
    SPECULAR_LIGHT += highlight_color * LIGHT_COLOR * ATTENUATION * facing_light * ((silk * 0.60 + grazing * 0.14) * disturbed_sheen + glint * 0.32) / PI;
}
"


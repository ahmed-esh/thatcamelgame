[sub_resource type="Shader" id="Shader_tg6r4"]
code = "shader_type spatial;
render_mode diffuse_lambert, specular_disabled;
uniform vec3 stone_color : source_color = vec3(0.28, 0.34, 0.61);
varying vec3 rock_position;
varying vec3 rock_normal;
void vertex() {
    rock_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
    rock_normal = normalize(MODEL_NORMAL_MATRIX * NORMAL);
}
void fragment() {
    float slope = 1.0 - clamp(normalize(rock_normal).y, 0.0, 1.0);
    float layer = sin(rock_position.y * 3.0 + sin(rock_position.x * 0.18) * 0.7 + sin(rock_position.z * 0.15));
    float strata = smoothstep(0.5, 0.9, layer);
    float broad = sin(rock_position.y * 0.42 + sin(rock_position.x * 0.04)) * 0.5 + 0.5;
    ALBEDO = mix(stone_color, vec3(0.22, 0.25, 0.48), smoothstep(0.02, 0.3, slope) * 0.78) * (0.92 + broad * 0.08 - strata * 0.06);
    ROUGHNESS = 1.0;
}
#include \"res://Shaders/toon_light.gdshaderinc\"
"

